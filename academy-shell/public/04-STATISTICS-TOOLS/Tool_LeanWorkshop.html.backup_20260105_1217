                    const demand = parseFloat(data.demand) || 1;
                    const availTime = parseFloat(data.avail_time) || 1;

                    const taktTime = availTime / demand;

                    // Parse metrics
                    let totalVA = 0;
                    const stepData = steps.map((s, i) => {
