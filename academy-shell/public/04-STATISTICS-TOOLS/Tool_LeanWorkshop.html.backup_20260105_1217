            // =====================================
            // VOC TREE DIAGRAM
            // =====================================
            'voc_tree': {
                title: "?? VOC Tree",
                phase: "DEFINE",
                hook: "Translate vague needs into measurable requirements.",
                history: "Critical to Quality (CTQ) Tree. A key tool in Design for Six Sigma (DFSS).",
                what: "A diagram that breaks down broad customer needs into specific, measurable requirements.",
                why: "To ensure the product/process design actually meets the customer's true needs.",
                when: "During Define phase, after collecting Voice of Customer (VOC) data.",
                standard: "Levels: Need (Driver) -> Driver (Key Issue) -> CTQ (Requirement).",
                interp: "A complete tree ensures no customer requirement is missed and every spec traces back to a need.",
                ref: "Tip: Ensure the final leaf nodes are measurable (have units and targets).",
                steps: [
                    { title: "1. Identify Need", desc: "Capture the 'Voice of the Customer' (verbatim if possible)." },
                    { title: "2. List Drivers", desc: "Identify main quality drivers (e.g., Quality, Speed, Cost)." },
                    { title: "3. Define CTQs", desc: "Break drivers down into Critical-To-Quality requirements." },
                    { title: "4. Validate", desc: "Ensure each CTQ is specific and measurable." }
                ],
                inputs: [
                    { id: 'customer', label: '1. Customer / Segment', type: 'text', placeholder: 'e.g., Online Shoppers' },
                    { id: 'need', label: '2. Customer Need (Voice)', type: 'textarea', tip: 'What did the customer say they want?', placeholder: '"I want my delivery fast and cheap."' },
                    { id: 'drivers', label: '3. Key Drivers (Comma separated)', type: 'text', tip: 'Main categories of need.', placeholder: 'Speed, Cost, Condition' },
                    { id: 'ctqs', label: '4. CTQs (Line separated)', type: 'textarea', tip: 'Specific requirements. Format: Driver: Requirement', placeholder: 'Speed: Delivery within 2 days\nCost: Shipping under $5\nCondition: No damage to box' }
                ],
                scenarios: {
                    'service': {
                        desc: "Hotel Guest Experience",
                        data: {
                            customer: "Business Travelers",
                            need: "\"I want a hassle-free, comfortable stay so I can work and rest.\"",
                            drivers: "Comfort, Efficiency, Connectivity",
                            ctqs: "Comfort: Quiet room (<40dB)\nComfort: High quality mattress\nEfficiency: Check-in under 3 mins\nEfficiency: Express checkout available\nConnectivity: Wi-Fi speed >50Mbps"
                        }
                    },
                    'mfg': {
                        desc: "Car Dashboard Assembly",
                        data: {
                            customer: "Vehicle Assembly Plant",
                            need: "\"Isolate noise, look premium, and allow easy install.\"",
                            drivers: "Aesthetics, NVH, Installability",
                            ctqs: "Aesthetics: No visible gap >1mm\nAesthetics: Color match Delta-E <1.0\nNVH: Vibration damping >80%\nInstallability: Snap-fit force <50N"
                        }
                    }
                },
                render: (data) => {
                    const customer = data.customer || "Customer";
                    const need = data.need || "Need";
                    const drivers = (data.drivers || '').split(',').map(d => d.trim()).filter(d => d);
                    const ctqLines = (data.ctqs || '').split('\n').map(l => l.trim()).filter(l => l);

                    // Build hierarch data structure
                    const tree = { name: need, type: 'need', children: [] };

                    drivers.forEach(d => {
                        const driverNode = { name: d, type: 'driver', children: [] };
                        // Find CTQs for this driver
                        ctqLines.forEach(line => {
                            const parts = line.split(':');
                            if (parts.length >= 2) {
                                if (parts[0].trim().toLowerCase() === d.toLowerCase()) {
                                    driverNode.children.push({ name: parts.slice(1).join(':').trim(), type: 'ctq' });
                                }
                            }
                        });
                        // If no specific match, maybe assign unassigned ones? For now, exact match logic.
                        tree.children.push(driverNode);
                    });

                    // SVG Config
                    const W = 900;
                    const H = 500;
                    const LEFT_M = 50;
                    const LEVEL_W = 250;

                    let svg = '';

                    // Draw nodes recursively
                    // Layout: Horizontal Tree
                    // Level 0: Need (Left)
                    // Level 1: Drivers (Middle)
                    // Level 2: CTQs (Right)

                    const drawNode = (node, x, y, w, h, color) => {
                        return `<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="5" fill="${color}" stroke="#2c3e50" stroke-width="1"/>
                            <foreignObject x="${x}" y="${y}" width="${w}" height="${h}">
                                <div style="display:flex;align-items:center;justify-content:center;height:100%;text-align:center;font-size:11px;padding:5px;font-family:Arial;color:white;font-weight:bold;">${node.name}</div>
                            </foreignObject>`;
                    };

                    const drawLink = (x1, y1, x2, y2) => {
                        return `<path d="M${x1},${y1} C${(x1 + x2) / 2},${y1} ${(x1 + x2) / 2},${y2} ${x2},${y2}" stroke="#bdc3c7" stroke-width="2" fill="none"/>`;
                    };

                    // NEED Node
                    const needH = 80;
                    const needY = H / 2 - needH / 2;
                    svg += drawNode({ name: `"${need}"` }, LEFT_M, needY, 180, needH, '#E74C3C');
                    svg += `<text x="${LEFT_M + 90}" y="${needY - 10}" text-anchor="middle" font-size="12" fill="#E74C3C" font-weight="bold">CUSTOMER NEED (VOC)</text>`;

                    // DRIVERS
                    const dCount = tree.children.length;
                    const dSpace = H / Math.max(dCount, 1);

                    tree.children.forEach((driver, i) => {
                        const dY = (i * dSpace) + (dSpace / 2) - 30; // 30 is half height of 60
                        const dX = LEFT_M + 250;

                        // Link Need -> Driver
                        svg += drawLink(LEFT_M + 180, H / 2, dX, dY + 30);

                        // Driver Node
                        svg += drawNode(driver, dX, dY, 150, 60, '#3498DB');
                        if (i === 0) svg += `<text x="${dX + 75}" y="${dY - 10}" text-anchor="middle" font-size="12" fill="#3498DB" font-weight="bold">DRIVERS</text>`;

                        // CTQS
                        const cCount = driver.children.length;
                        if (cCount > 0) {
                            const cSpace = (dSpace * 0.9) / cCount; // Constrain CTQs to driver's vertical space
                            const cStartY = (i * dSpace) + (dSpace * 0.05); // Start slightly offset

                            driver.children.forEach((ctq, j) => {
                                const cY = cStartY + (j * cSpace) + (cSpace / 2) - 20; // 20 is half height of 40
                                const cX = dX + 220;

                                // Link Driver -> CTQ
                                svg += drawLink(dX + 150, dY + 30, cX, cY + 20);

                                // CTQ Node
                                svg += drawNode(ctq, cX, cY, 180, 40, '#27AE60');
                                if (i === 0 && j === 0) svg += `<text x="${cX + 90}" y="${cY - 10}" text-anchor="middle" font-size="12" fill="#27AE60" font-weight="bold">CTQs (Requirements)</text>`;
                            });
                        }
                    });

                    let html = `<div style="font-family:'Segoe UI',sans-serif; padding:15px; background:white;">
                    <h3 style="color:#2c3e50; margin:0 0 10px 0;">?? VOC Translation Tree (CTQ Tree)</h3>
                    <div style="font-size:12px; color:#7f8c8d; margin-bottom:15px;">Targeting Customer: <b>${customer}</b></div>
                    
                    <div style="overflow-x:auto; border:1px solid #ecf0f1; border-radius:8px; background:#fafafa;">
                        <svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}">
                            ${svg}
                        </svg>
                    </div>
                </div>`;
                    return html;
                }
            },

            // =====================================
