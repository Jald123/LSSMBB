                    { id: 'metrics', label: '2. Metrics (C/T sec, C/O min, Uptime %)', type: 'textarea', tip: 'One row per step. e.g., "30,10,95"', placeholder: '30,10,95\n45,5,90\n60,0,98' },
                    { id: 'inventory', label: '3. Inventory/WIP (Line separated)', type: 'textarea', tip: 'Units before each step and at end.', placeholder: '100\n50\n20\n0' },
                    { id: 'demand', label: '4. Customer Demand (Units/Day)', type: 'text', placeholder: '400' },
                    { id: 'avail_time', label: '5. Available Time (Sec/Day)', type: 'text', placeholder: '27000' }
                ],
