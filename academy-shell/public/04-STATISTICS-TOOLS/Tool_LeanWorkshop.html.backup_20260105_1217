            'cne': {
                title: "Cause & Effect Matrix",
                phase: "MEASURE",
                hook: "Prioritize inputs (Xs) based on Customer Outputs (Ys).",
                history: "Also known as the X-Y Matrix. It evolved from Quality Function Deployment (QFD) principles to specifically link process inputs to customer requirements, narrowing the funnel of potential factors before detailed statistical analysis.",
                what: "X-Y Matrix correlating process inputs to key outputs.",
                why: "To narrow down the list of potential variables (Xs) to focus on.",
                when: "After Process Map/Fishbone, before FMEA.",
                standard: "Score: 1 (Low), 3 (Med), 9 (High).",
                interp: "Focus on Xs with the highest Total Weighted Scores.",
                ref: "Customer Importance (1-10) drives the weighting.",
                steps: [
                    { title: "1. List Outputs (Ys)", desc: "What does the customer care about? Assign importance (1-10)." },
                    { title: "2. List Inputs (Xs)", desc: "What process steps or variables impact these outputs?" },
                    { title: "3. Correlate", desc: "Rate impact of X on Y (0=None, 1=Weak, 3=Moderate, 9=Strong)." },
                    { title: "4. Calculate", desc: "Multiply Impact * Importance to get weighted score for each X." }
                ],
                inputs: [
                    { id: 'ys', label: '1. Customer Outputs (Ys)', type: 'textarea', tip: 'Format: Output Name: Importance (1-10)', placeholder: 'Speed: 9\nAccuracy: 10\nCost: 5' },
                    { id: 'xs', label: '2. Process Inputs (Xs)', type: 'textarea', tip: 'One per line.', placeholder: 'Training\nTemperature\nSoftware Version...' },
                    { id: 'scores', label: '3. Correlations', type: 'textarea', tip: 'Format: X-Row-Index, Y-Col-Index, Score(0,1,3,9)', placeholder: '0,0,9\n0,1,3\n1,0,1...' }
                ],
                scenarios: {
                    'health': {
                        desc: "Patient Wait Times",
                        data: {
                            ys: "Patient Sat: 9\nClinical Outcome: 10\nCost: 5",
                            xs: "Staffing Levels\nArrival Rate\nTriage Process\nEquipment Availability",
                            scores: "0,0,9\n0,1,3\n0,2,1\n1,0,3\n1,1,0\n1,2,9\n2,0,9\n2,1,9\n2,2,3\n3,0,3\n3,1,9\n3,2,1"
                        }
                    },
                    'mfg': {
                        desc: "Welding Defect Reduction",
                        data: {
                            ys: "Weld Strength: 10\nVisual Appearance: 7\nCycle Time: 6",
                            xs: "Amperage\nTravel Speed\nWire Feed Rate\nGas Flow",
                            scores: "0,0,9\n0,1,3\n0,2,3\n1,0,9\n1,1,9\n1,2,9\n2,0,3\n2,1,1\n2,2,1\n3,0,3\n3,1,1\n3,2,0"
                        }
                    },
                    'service': {
                        desc: "Loan Application Process",
                        data: {
                            ys: "Approval Speed: 9\nError Rate: 10\nCustomer Exp: 8",
                            xs: "Data Entry Accuracy\nCredit Check API\nUnderwriter Skill\nDocument Quality",
                            scores: "0,0,3\n0,1,9\n0,2,1\n1,0,9\n1,1,0\n1,2,3\n2,0,3\n2,1,9\n2,2,9\n3,0,1\n3,1,9\n3,2,1"
                        }
                    }
                },
                render: (data) => {
                    const ys = data.ys.split('\n').filter(l => l).map(l => {
                        const p = l.split(':'); return { name: p[0], imp: parseInt(p[1]) || 1 };
                    });
                    const xs = data.xs.split('\n').filter(l => l);
                    const map = {};
                    data.scores.split('\n').forEach(l => {
                        const p = l.split(',');
                        if (p.length === 3) map[`${p[0].trim()}-${p[1].trim()}`] = parseInt(p[2]) || 0;
                    });

                    let head = '<thead><tr><th style="text-align:left; background:#eee; color:#333; border:1px solid #ccc;">Inputs (Xs) \\ Outputs (Ys)</th>';
                    ys.forEach(y => head += `<th style="background:#2980b9; color:white; padding:10px; width:100px; border:1px solid #ccc;">${y.name}<br><span style="font-size:11px; opacity:0.8;">(Imp: ${y.imp})</span></th>`);
                    head += '<th style="background:#2c3e50; color:white; border:1px solid #ccc;">Total Score</th></tr></thead>';

                    let body = '<tbody>';
                    xs.forEach((x, i) => {
                        let total = 0;
                        let rowHTML = `<td style="font-weight:bold; padding:10px; border:1px solid #ccc;">${x}</td>`;
                        ys.forEach((y, j) => {
                            const score = map[`${i}-${j}`] || 0;
                            total += score * y.imp;
                            let bg = 'white';
                            let color = 'black';
                            if (score === 9) { bg = '#27ae60'; color = 'white'; }
                            if (score === 3) { bg = '#f39c12'; color = 'white'; }
                            if (score === 1) { bg = '#ecf0f1'; color = '#7f8c8d'; }
                            rowHTML += `<td style="text-align:center; background:${bg}; color:${color}; border:1px solid #ccc;">${score || ''}</td>`;
                        });
                        body += `<tr>${rowHTML}<td style="text-align:center; font-weight:bold; background:#ecf0f1; border:1px solid #ccc; font-size:16px;">${total}</td></tr>`;
                    });
                    body += '</tbody>';

                    return `<div style="overflow-x:auto; padding:10px;"><table class="sipoc-table" style="border-collapse:collapse; width:100%; box-shadow:0 0 10px rgba(0,0,0,0.1);">${head}${body}</table></div>
