                        </pattern>
                        <rect width="100%" height="100%" fill="url(#grid)"/>
                    `;

                    // Draw edges first
                    edges.forEach(e => {
                        const n1 = nodes[e.from], n2 = nodes[e.to];
                        if (!n1 || !n2 || n1.x === undefined || n2.x === undefined) return;

                        const x1 = n1.x + NODE_W / 2, y1 = n1.y + NODE_H;
                        const x2 = n2.x + NODE_W / 2, y2 = n2.y;

                        if (y2 <= y1 + 10) {
                            // Loop back - curve around
                            const offset = 60;
                            svg += `<path d="M${x1},${n1.y + NODE_H / 2} C${x1 + offset + 50},${n1.y + NODE_H / 2} ${x2 + offset + 50},${n2.y + NODE_H / 2} ${n2.x + NODE_W},${n2.y + NODE_H / 2}" 
                                fill="none" stroke="#7f8c8d" stroke-width="2" stroke-dasharray="5,3" marker-end="url(#flowArrow)"/>`;
                        } else {
                            // Normal downward flow
                            const midY = (y1 + y2) / 2;
                            if (Math.abs(x1 - x2) > 10) {
                                svg += `<path d="M${x1},${y1} L${x1},${midY} L${x2},${midY} L${x2},${y2}" fill="none" stroke="#34495e" stroke-width="2" marker-end="url(#flowArrow)"/>`;
