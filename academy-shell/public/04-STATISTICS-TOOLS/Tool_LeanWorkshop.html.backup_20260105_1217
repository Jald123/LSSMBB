                render: (data) => {
                    const processTitle = data.title || 'Process Flowchart';
                    const nodeLines = (data.nodes || '').split('\n').map(s => s.trim()).filter(s => s);
                    const edgeLines = (data.edges || '').split('\n').map(s => s.trim()).filter(s => s);

                    const nodes = {};
                    nodeLines.forEach(line => {
                        const parts = line.split(',').map(p => p.trim());
                        if (parts.length >= 3) {
                            nodes[parts[0]] = { id: parts[0], label: parts[1], type: parts[2].toLowerCase() };
                        }
                    });

                    const edges = edgeLines.map(line => {
                        const parts = line.split(',').map(p => p.trim());
                        return { from: parts[0], to: parts[1], label: parts[2] || '' };
                    });

                    // BFS Leveling
                    const levels = {};
                    const queue = [];
                    Object.values(nodes).forEach(n => {
                        if (n.type === 'start') { levels[n.id] = 0; queue.push(n.id); }
                    });
                    if (queue.length === 0 && Object.keys(nodes).length > 0) {
                        const first = Object.keys(nodes)[0];
                        levels[first] = 0; queue.push(first);
                    }

                    const visited = new Set();
                    while (queue.length > 0) {
                        const curr = queue.shift();
                        if (visited.has(curr)) continue;
                        visited.add(curr);
                        const currLevel = levels[curr];
                        edges.forEach(e => {
                            if (e.from === curr && levels[e.to] === undefined) {
                                levels[e.to] = currLevel + 1;
                                queue.push(e.to);
                            }
                        });
                    }

                    // Group by level
                    const levelNodes = {};
                    Object.keys(nodes).forEach(nId => {
                        const l = levels[nId] !== undefined ? levels[nId] : 99;
                        if (!levelNodes[l]) levelNodes[l] = [];
                        levelNodes[l].push(nodes[nId]);
                    });

                    // Calculate coordinates
                    const NODE_W = 140, NODE_H = 55, Y_SPACE = 95, X_SPACE = 170;
                    const maxNodesInLevel = Math.max(...Object.values(levelNodes).map(arr => arr.length), 1);
                    const SVG_W = Math.max(900, maxNodesInLevel * X_SPACE + 100);

                    Object.keys(levelNodes).forEach(l => {
                        const nodesInLevel = levelNodes[l];
                        const totalWidth = nodesInLevel.length * X_SPACE;
                        const startX = (SVG_W - totalWidth) / 2 + X_SPACE / 2 - NODE_W / 2;
                        nodesInLevel.forEach((n, i) => {
                            n.x = startX + i * X_SPACE;
                            n.y = 60 + parseInt(l) * Y_SPACE;
                        });
                    });

                    let maxY = 0;
                    Object.values(nodes).forEach(n => { maxY = Math.max(maxY, (n.y || 0) + NODE_H); });
                    const SVG_H = Math.max(500, maxY + 80);

                    // Shape definitions
                    const getShape = (n, cx, cy) => {
                        const hw = NODE_W / 2, hh = NODE_H / 2;
                        switch (n.type) {
                            case 'start': case 'end':
                                return `<rect x="${n.x}" y="${n.y}" width="${NODE_W}" height="${NODE_H}" rx="27" 
                                    fill="${n.type === 'start' ? '#d5f5e3' : '#fadbd8'}" 
                                    stroke="${n.type === 'start' ? '#27ae60' : '#e74c3c'}" stroke-width="2.5"/>`;
                            case 'dec':
                                return `<polygon points="${cx},${n.y} ${n.x + NODE_W},${cy} ${cx},${n.y + NODE_H} ${n.x},${cy}" 
                                    fill="#fef9e7" stroke="#f1c40f" stroke-width="2.5"/>`;
                            case 'doc':
                                return `<path d="M${n.x},${n.y} h${NODE_W} v${NODE_H - 10} q${-NODE_W / 4},10 ${-NODE_W / 2},0 q${-NODE_W / 4},-10 ${-NODE_W / 2},0 v${-(NODE_H - 10)} z" 
                                    fill="#ebf5fb" stroke="#3498db" stroke-width="2"/>`;
                            case 'io':
                                const skew = 15;
                                return `<polygon points="${n.x + skew},${n.y} ${n.x + NODE_W},${n.y} ${n.x + NODE_W - skew},${n.y + NODE_H} ${n.x},${n.y + NODE_H}" 
                                    fill="#f5eef8" stroke="#9b59b6" stroke-width="2"/>`;
                            default: // proc
                                return `<rect x="${n.x}" y="${n.y}" width="${NODE_W}" height="${NODE_H}" rx="6" 
                                    fill="white" stroke="#3498db" stroke-width="2.5"/>`;
                        }
                    };

                    let svg = `
                        <defs>
                            <marker id="flowArrow" markerWidth="12" markerHeight="8" refX="11" refY="4" orient="auto">
                                <polygon points="0 0, 12 4, 0 8" fill="#34495e"/>
                            </marker>
                            <filter id="nodeShadow" x="-20%" y="-20%" width="140%" height="140%">
                                <feDropShadow dx="2" dy="2" stdDeviation="3" flood-opacity="0.15"/>
