                        const parts = line.split(',').map(p => p.trim());
                        if (parts.length >= 4) {
                            const laneIdx = parseInt(parts[1]) - 1;
                            nodes[parts[0]] = {
                                id: parts[0],
                                lane: Math.max(0, Math.min(laneIdx, laneNames.length - 1)),
                                label: parts[2],
                                type: parts[3].toLowerCase()
                            };
                        }
                    });

                    const edges = edgeLines.map(line => {
                        const parts = line.split(',').map(p => p.trim());
                        return { from: parts[0], to: parts[1], label: parts[2] || '' };
                    });

                    // BFS Leveling
                    const levels = {};
                    const queue = [];
                    Object.values(nodes).forEach(n => {
                        if (n.type === 'start') { levels[n.id] = 0; queue.push(n.id); }
                    });
                    if (queue.length === 0 && Object.keys(nodes).length > 0) {
                        const first = Object.keys(nodes)[0]; levels[first] = 0; queue.push(first);
                    }
                    const visited = new Set();
                    while (queue.length > 0) {
                        const curr = queue.shift();
                        if (visited.has(curr)) continue;
                        visited.add(curr);
                        edges.forEach(e => {
                            if (e.from === curr && levels[e.to] === undefined) {
                                levels[e.to] = levels[curr] + 1;
                                queue.push(e.to);
                            }
                        });
                    }

                    // Layout constants
                    const LANE_H = 90, NODE_W = 110, NODE_H = 45, X_SPACE = 140, HEADER_W = 80, START_X = HEADER_W + 40;

                    Object.values(nodes).forEach(n => {
                        const l = levels[n.id] || 0;
                        n.x = START_X + l * X_SPACE;
                        n.y = (n.lane * LANE_H) + (LANE_H / 2) - (NODE_H / 2);
                    });

                    let maxX = 0;
                    Object.values(nodes).forEach(n => maxX = Math.max(maxX, (n.x || 0) + NODE_W));
                    const SVG_W = Math.max(900, maxX + 60);
                    const SVG_H = laneNames.length * LANE_H + 10;

                    // Swimmer icon SVG path
                    const swimmerIcon = (x, y, color) => `
                        <g transform="translate(${x}, ${y}) scale(0.6)">
                            <circle cx="8" cy="6" r="5" fill="${color}"/>
                            <path d="M 0 18 Q 8 14 16 18 Q 24 22 32 18" fill="none" stroke="${color}" stroke-width="2.5" stroke-linecap="round"/>
                            <line x1="8" y1="11" x2="8" y2="22" stroke="${color}" stroke-width="2.5" stroke-linecap="round"/>
                            <line x1="8" y1="14" x2="0" y2="20" stroke="${color}" stroke-width="2" stroke-linecap="round"/>
                            <line x1="8" y1="14" x2="16" y2="20" stroke="${color}" stroke-width="2" stroke-linecap="round"/>
                        </g>
                    `;

                    let svg = `
                        <defs>
                            <marker id="swimArrow" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
                                <polygon points="0 0, 10 4, 0 8" fill="white"/>
                            </marker>
                            <filter id="laneShadow" x="-5%" y="-5%" width="110%" height="110%">
                                <feDropShadow dx="2" dy="2" stdDeviation="2" flood-opacity="0.2"/>
                            </filter>
