                    { id: 'correlations', label: '4. Correlations (CSV lines)', type: 'textarea', tip: 'Row per Input. Scores: 0, 1, 3, 9. e.g., "9,3,1" for first input.', placeholder: '9,3,1\n3,9,0\n1,1,9' }
