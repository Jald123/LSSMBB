                    });

                    // Draw Nodes
                    Object.values(nodes).forEach(n => {
                        const cx = n.x + NODE_W / 2, cy = n.y + NODE_H / 2;
                        const laneColor = laneColors[n.lane % laneColors.length];

                        // Node shapes with icons
