    <style>
        /* TOOLTIP STYLE */
        .input-tooltip {
            position: relative;
            cursor: pointer;
            margin-left: 5px;
            color: var(--accent);
            font-size: 14px;
        }

        .input-tooltip:hover::after {
            content: attr(data-tip);
            position: absolute;
            bottom: 100%;
            left: 50%;
            transform: translateX(-50%);
            background: #222;
            color: #eee;
            padding: 10px;
            border-radius: 4px;
            width: 250px;
            font-size: 11px;
            line-height: 1.4;
            z-index: 1000;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
            pointer-events: none;
            border: 1px solid var(--accent);
            white-space: normal;
        }

        /* STORY STEPS */
        .story-container {
            margin-top: 15px;
            padding-top: 10px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .story-step {
            border-left: 2px solid var(--accent);
            padding-left: 15px;
            margin-bottom: 15px;
            position: relative;
        }

        .story-step::before {
            content: '';
            position: absolute;
            left: -6px;
            top: 0;
            width: 10px;
            height: 10px;
            background: var(--accent);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--accent);
        }

        /* LAYOUT OVERRIDES */
        .app-grid {
            display: grid;
            grid-template-columns: 260px 1fr;
            gap: 20px;
            min-height: 90vh;
        }

        .sidebar {
            background: var(--surface-2);
            border-right: 1px solid rgba(255, 255, 255, 0.05);
            padding: 15px;
            border-radius: 12px;
        }



        .tool-btn {
            display: flex;
            align-items: center;
            width: 100%;
            padding: 12px 15px;
            margin-bottom: 5px;
            background: transparent;
            border: none;
            color: var(--text-secondary);
            text-align: left;
            cursor: pointer;
            border-radius: 6px;
            transition: all 0.2s;
            font-size: 13px;
        }

        .tool-btn:hover {
            background: rgba(255, 255, 255, 0.05);
            color: white;
            transform: translateX(5px);
        }

        .tool-btn.active {
            background: linear-gradient(90deg, rgba(27, 107, 130, 0.2), transparent);
            color: var(--accent);
            border-left: 3px solid var(--accent);
            font-weight: 600;
        }

        .phase-header {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(255, 255, 255, 0.3);
            margin: 20px 0 10px 10px;
        }

        /* PREMIUM INFO CARDS */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }

        .info-card {
            background: var(--surface-2);
            padding: 15px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 13px;
            color: var(--text-secondary);
        }

        .info-title {
            color: var(--accent);
            font-size: 11px;
            text-transform: uppercase;
            font-weight: bold;
            margin-bottom: 8px;
            letter-spacing: 0.5px;
        }

        /* SCENARIO SELECTOR STYLE */
        .scenario-select {
            width: 100%;
            padding: 12px;
            background: #000;
            border: 1px solid var(--primary);
            color: white;
            border-radius: 6px;
            margin-bottom: 15px;
            cursor: pointer;
        }

        /* VISUAL TEMPLATES */
        .sipoc-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        .sipoc-table th {
            background: var(--primary);
            color: white;
            padding: 10px;
            font-size: 12px;
            text-transform: uppercase;
        }

        .sipoc-table td {
            background: white;
            color: #333;
            padding: 10px;
            border: 1px solid #ddd;
            vertical-align: top;
        }

        .sipoc-table textarea {
            width: 100%;
            border: none;
            background: transparent;
            font-family: inherit;
            resize: vertical;
            min-height: 100px;
        }

        .fishbone-visual {
            position: relative;
            min-height: 400px;
            background: white;
            color: #333;
            padding: 20px;
            border-radius: 4px;
        }

        .fish-head {
            position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
            border: 2px solid #E74C3C;
            padding: 15px;
            border-radius: 8px;
            font-weight: bold;
            background: #FDEDEC;
        }

        .fish-spine {
            position: absolute;
            top: 50%;
            left: 50px;
            right: 180px;
            height: 4px;
            background: #333;
        }
    </style>
</head>

