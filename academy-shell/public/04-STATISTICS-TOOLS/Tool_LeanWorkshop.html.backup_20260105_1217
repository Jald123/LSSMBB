                            const numStyle = count > 0 ? 'font-weight:bold; font-size:14px; color:#333;' : 'color:transparent;';
                            heatmap += `<div style="background:${bg}; height:35px; display:flex; align-items:center; justify-content:center; ${border} ${numStyle}">${count || 0}</div>`;
                        }
                    }
                    heatmap += '</div>';

                    return `
