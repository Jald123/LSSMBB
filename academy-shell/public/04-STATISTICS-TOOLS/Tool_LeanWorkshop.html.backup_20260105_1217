                        <rect width="100%" height="100%" fill="#2c3e50"/>
                    `;

                    // Draw Lanes with colors and swimmer icons
                    laneNames.forEach((lane, i) => {
                        const y = i * LANE_H;
                        const color = laneColors[i % laneColors.length];

                        // Lane background (alternating dark shades)
                        svg += `<rect x="${HEADER_W}" y="${y}" width="${SVG_W - HEADER_W}" height="${LANE_H}" fill="${i % 2 === 0 ? '#34495e' : '#3d566e'}" stroke="none"/>`;

                        // Lane divider line
                        if (i > 0) {
                            svg += `<line x1="${HEADER_W}" y1="${y}" x2="${SVG_W}" y2="${y}" stroke="#4a6785" stroke-width="1"/>`;
                        }

                        // Colored header
                        svg += `<rect x="0" y="${y}" width="${HEADER_W}" height="${LANE_H}" fill="${color}" stroke="none"/>`;

                        // Swimmer icon
                        svg += swimmerIcon(HEADER_W / 2 - 10, y + 8, 'rgba(255,255,255,0.9)');

                        // Lane name (rotated)
                        svg += `<text x="${HEADER_W / 2}" y="${y + LANE_H - 15}" text-anchor="middle" fill="white" font-size="11" font-weight="bold" style="writing-mode: tb; letter-spacing: 1px;">${lane.toUpperCase()}</text>`;
                    });

                    // Count handoffs (arrows crossing lanes)
                    let handoffCount = 0;
                    edges.forEach(e => {
                        if (nodes[e.from] && nodes[e.to] && nodes[e.from].lane !== nodes[e.to].lane) handoffCount++;
                    });

                    // Draw Connections
                    edges.forEach(e => {
                        const n1 = nodes[e.from], n2 = nodes[e.to];
                        if (!n1 || !n2) return;

                        const x1 = n1.x + NODE_W, y1 = n1.y + NODE_H / 2;
                        const x2 = n2.x, y2 = n2.y + NODE_H / 2;
                        const isHandoff = n1.lane !== n2.lane;
                        const strokeColor = isHandoff ? '#e74c3c' : 'white';
                        const strokeWidth = isHandoff ? 2.5 : 2;

                        if (x2 < x1) {
                            // Loop back
                            svg += `<path d="M${x1},${y1} C${x1 + 40},${y1} ${x1 + 40},${y2 - 40} ${(x1 + x2) / 2},${y2 - 40} L${x2 - 20},${y2 - 40} C${x2 - 40},${y2 - 40} ${x2 - 40},${y2} ${x2},${y2}" fill="none" stroke="${strokeColor}" stroke-width="${strokeWidth}" stroke-dasharray="5,3" marker-end="url(#swimArrow)"/>`;
                        } else {
                            // Normal forward flow with curved path
                            const midX = (x1 + x2) / 2;
                            svg += `<path d="M${x1},${y1} C${midX},${y1} ${midX},${y2} ${x2},${y2}" fill="none" stroke="${strokeColor}" stroke-width="${strokeWidth}" marker-end="url(#swimArrow)"/>`;
                        }

