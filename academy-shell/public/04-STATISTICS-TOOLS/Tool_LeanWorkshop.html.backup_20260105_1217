                            <td style="padding:10px; border-bottom:1px solid #eee;">${r.risk}</td>
                            <td style="text-align:center; border-bottom:1px solid #eee;">${r.imp}</td>
                            <td style="text-align:center; border-bottom:1px solid #eee;">${r.prob}</td>
                            <td style="text-align:center; background:${r.color}; color:white; font-weight:bold; border-bottom:1px solid #eee;">${r.score}</td>
                            <td style="padding:10px; border-bottom:1px solid #eee;">${r.mit}</td>
                        </tr>
                    `).join('');

                    // Heatmap logic
                    let heatmap = '<div style="display:grid; grid-template-columns:repeat(5, 1fr); gap:2px; font-size:10px; width:200px; border:1px solid #ccc; padding:2px; background:white;">';
                    for (let r = 5; r >= 1; r--) {
                        for (let c = 1; c <= 5; c++) {
                            const score = r * c;
                            let bg = '#d5f5e3'; // low
                            if (score >= 5) bg = '#abebc6';
                            if (score >= 10) bg = '#f9e79f'; // med
