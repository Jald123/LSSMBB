                    paths.forEach(p => {
                        stationTraffic[p.from] = (stationTraffic[p.from] || 0) + p.count;
                        stationTraffic[p.to] = (stationTraffic[p.to] || 0) + p.count;
                        stationAsStart[p.from] = (stationAsStart[p.from] || 0) + p.count;
                        stationAsEnd[p.to] = (stationAsEnd[p.to] || 0) + p.count;
