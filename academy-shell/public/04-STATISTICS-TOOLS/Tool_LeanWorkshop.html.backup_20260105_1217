                    }
                },
                render: (data) => {
                    const needs = data.needs.split('\n').filter(n => n.trim());
                    const specs = data.specs.split('\n').filter(s => s.trim());

                    // Parse Matrix
                    let matrix = Array(needs.length).fill().map(() => Array(specs.length).fill(0));
                    data.matrix.split('\n').forEach(line => {
                        const p = line.split(',');
                        if (p.length >= 3) {
                            const nIdx = needs.findIndex(x => x.includes(p[0].trim()));
                            const sIdx = specs.findIndex(x => x.includes(p[1].trim()));
                            if (nIdx > -1 && sIdx > -1) matrix[nIdx][sIdx] = parseInt(p[2].trim()) || 0;
                        }
                    });

                    // Calc Weights
                    const specWeights = Array(specs.length).fill(0);
                    needs.forEach((n, i) => {
                        specs.forEach((s, j) => {
                            specWeights[j] += (matrix[i][j]); // Simplified weight
                        });
                    });

                    // Construction
                    let html = `<div style="font-family:'Segoe UI', sans-serif; padding:20px; background:white;">`;

                    // Roof SVG
                    const roofW = specs.length * 60 + 200;
                    html += `<div style="display:flex; justify-content:center; margin-bottom:5px;">
                        <svg width="${roofW}" height="60" viewBox="0 0 ${roofW} 60">
                             <polygon points="${roofW / 2},0 ${roofW / 2 - specs.length * 30},60 ${roofW / 2 + specs.length * 30},60" fill="#ecf0f1" stroke="#bdc3c7" stroke-width="1"/>
                             <text x="50%" y="40" text-anchor="middle" font-size="10" fill="#bdc3c7">Correlation Matrix (Roof)</text>
                        </svg>
                    </div>`;

                    // Table
                    html += `<div style="overflow-x:auto;">
                        <table style="border-collapse:collapse; margin:auto; box-shadow:0 0 20px rgba(0,0,0,0.1);">
                            <thead>
                                <tr>
                                    <th style="background:white; border:none;"></th>
                                    ${specs.map(s => `<th style="background:#2c3e50; color:white; padding:10px; height:120px; border:1px solid #34495e; width:60px; vertical-align:bottom;">
                                        <div style="writing-mode:vertical-rl; transform:rotate(180deg); margin:auto; font-size:12px;">${s}</div>
                                    </th>`).join('')}
                                </tr>
                            </thead>
                            <tbody>`;

                    needs.forEach((n, i) => {
                        html += `<tr>
                            <td style="background:#2980b9; color:white; padding:10px; font-size:12px; border:1px solid #fff; width:150px;">${n}</td>`;
                        specs.forEach((s, j) => {
                            const score = matrix[i][j];
                            let col = score === 9 ? '#e74c3c' : (score === 3 ? '#f39c12' : (score === 1 ? '#2ecc71' : '#eee'));
                            let sym = score === 9 ? '●' : (score === 3 ? '○' : (score === 1 ? '▽' : ''));
                            html += `<td style="border:1px solid #bdc3c7; text-align:center; color:${col}; font-size:18px;">${sym}</td>`;
                        });
                        html += `</tr>`;
                    });

                    // Tech Importance
                    html += `<tr><td style="background:#2c3e50; color:white; text-align:right; padding:5px; font-size:11px;">Importance</td>
                        ${specs.map((s, i) => `<td style="background:#ecf0f1; border:1px solid #bdc3c7; text-align:center; font-weight:bold; font-size:12px;">${specWeights[i]}</td>`).join('')}
                    </tr>`;

                    html += `</tbody></table></div></div>`;
                    return html;
                }
            },
