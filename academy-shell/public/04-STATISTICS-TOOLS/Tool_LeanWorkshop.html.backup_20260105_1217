                                    </td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                    
                    <div style="margin-top:20px; padding:15px; background:#e8f4f8; border-left:4px solid #3498db; border-radius:4px;">
                        <h4 style="margin:0 0 10px 0; color:#2980b9; font-size:13px;">? Analysis Interpretation</h4>
