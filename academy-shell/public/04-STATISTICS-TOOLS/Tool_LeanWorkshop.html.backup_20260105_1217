                        // Edge label
                        if (e.label) {
                            const lx = (x1 + x2) / 2 + (x1 !== x2 ? 0 : 15);
                            const ly = (y1 + y2) / 2;
                            svg += `<rect x="${lx - 18}" y="${ly - 10}" width="36" height="18" rx="9" fill="#fff" stroke="#e74c3c" stroke-width="1.5"/>`;
                            svg += `<text x="${lx}" y="${ly + 4}" text-anchor="middle" font-size="11" font-weight="bold" fill="#e74c3c">${e.label}</text>`;
                        }
                    });

                    // Draw nodes
                    Object.values(nodes).forEach(n => {
                        if (n.x === undefined) return;
                        const cx = n.x + NODE_W / 2, cy = n.y + NODE_H / 2;
                        svg += `<g filter="url(#nodeShadow)">${getShape(n, cx, cy)}</g>`;

                        // Label - wrap if needed
                        const words = n.label.split(' ');
                        if (words.length > 3 && n.label.length > 20) {
                            const mid = Math.ceil(words.length / 2);
                            svg += `<text x="${cx}" y="${cy - 5}" text-anchor="middle" font-size="11" font-weight="600" fill="#2c3e50">${words.slice(0, mid).join(' ')}</text>`;
