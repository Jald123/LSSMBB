                                inputs.forEach(input => {
                                    const col = input.getAttribute('data-col');
                                    if (col) rowData[col] = input.value;
                                });
                                data.push(rowData);
                            });
                            return data;
                        };
                        
                        // Add initial empty row
                        addTableRow_${f.id}();
                    `;
                    afterRenderScripts.push(addRowFn);
                } else {
                    wrap.innerHTML += `<input type="text" id="input-${f.id}" style="width:100%; background:var(--surface-2); border:1px solid rgba(255,255,255,0.1); color:white; padding:8px; border-radius:4px;" placeholder="${f.placeholder || ''}">`;
                }
                formDiv.appendChild(wrap);
            });

            afterRenderScripts.forEach(script => {
                try { eval(script); } catch (e) { console.error('AfterRender script error:', e); }
            });

            // 5. Build Scenario Dropdown
            const select = document.getElementById('scenarioSelector');
            select.innerHTML = `<option value="custom">-- Custom Input --</option>`;
            if (tool.scenarios) {
                const keys = ['health', 'mfg', 'service'];
                keys.forEach(k => {
                    if (tool.scenarios[k]) {
                        let icon = '??';
                        if (k === 'mfg') icon = '??';
                        if (k === 'service') icon = '??';
                        let label = tool.scenarios[k].desc;
                        if (k === 'health') label = "Healthcare: " + label;
                        if (k === 'mfg') label = "Manufacturing: " + label;
                        if (k === 'service') label = "Service/Office: " + label;

                        select.innerHTML += `<option value="${k}">${icon} ${label}</option>`;
                    }
                });

                for (const [key, val] of Object.entries(tool.scenarios)) {
                    if (!keys.includes(key) && key !== 'ex1' && key !== 'ex2') {
                        let label = val.desc || key.toUpperCase();
                        select.innerHTML += `<option value="${key}">? ${label}</option>`;
                    }
                }
            }

            const existingDescEl = document.getElementById('scenarioDesc');
            if (existingDescEl) {
                existingDescEl.remove();
            }

            // 6. Initial Render
            updateVisual();
        }

        function applyScenario() {
            const tool = toolDB[currentToolId];
            const scenarioKey = document.getElementById('scenarioSelector').value;

            // Remove existing description if present
            const existingDescEl = document.getElementById('scenarioDesc');
            if (existingDescEl) {
                existingDescEl.remove();
            }

            if (scenarioKey === 'custom') {
                tool.inputs.forEach(f => {
                    const el = document.getElementById('input-' + f.id);
                    if (el) el.value = '';
                });
                updateVisual();
                return;
            }

            const scen = tool.scenarios[scenarioKey];
            if (scen) {
                // Maybe update a small text under the dropdown
                const descEl = document.createElement('div');
                descEl.id = 'scenarioDesc';
                descEl.style.fontSize = '12px'; descEl.style.color = 'var(--accent)'; descEl.style.marginBottom = '10px'; descEl.style.fontStyle = 'italic';
                const sel = document.getElementById('scenarioSelector');
                sel.parentNode.insertBefore(descEl, sel.nextSibling);

                document.getElementById('scenarioDesc').innerText = "Loaded: " + scen.desc;

                // Fill Data
                const data = scen.data;
                for (const [k, v] of Object.entries(data)) {
                    const el = document.getElementById('input-' + k);
                    if (el) el.value = v;
                }

                // Special handling for RACI tool - auto-generate grid after loading scenario
                if (currentToolId === 'raci' && typeof generateRACIGrid === 'function') {
                    setTimeout(() => {
                        generateRACIGrid();
                        // Also pre-fill the matrix data from scenario
                        if (scen.data.matrix) {
                            const lines = scen.data.matrix.split('\n');
                            lines.forEach(line => {
                                const parts = line.split(',').map(p => p.trim());
                                if (parts.length >= 3) {
                                    const row = parseInt(parts[0]) - 1;
                                    const col = parseInt(parts[1]) - 1;
                                    const code = parts[2].toUpperCase();
                                    const key = row + '-' + col;
                                    window.raciData[key] = code;
                                    const cell = document.getElementById('raci-' + key);
                                    if (cell) {
                                        const colors = { R: '#27ae60', A: '#e74c3c', C: '#f39c12', I: '#3498db' };
                                        cell.setAttribute('data-value', code);
                                        cell.textContent = code;
                                        cell.style.background = colors[code] || '#fff';
                                        cell.style.color = '#fff';
                                    }
                                }
                            });
                            updateRACITextarea();
                        }
                    }, 100);
                }

                // Special handling for Spaghetti Diagram - populate tables from scenario
                if (currentToolId === 'spaghetti') {
                    setTimeout(() => {
                        // Clear existing rows
                        const stationsBody = document.getElementById('stationsBody');
                        const pathsBody = document.getElementById('pathsBody');
                        if (stationsBody) stationsBody.innerHTML = '';
                        if (pathsBody) pathsBody.innerHTML = '';

                        // Populate stations table
                        if (scen.data.stations && typeof addStationRow === 'function') {
                            const stationLines = scen.data.stations.split('\n').filter(l => l.trim());
                            stationLines.forEach(line => {
                                const parts = line.split(',').map(p => p.trim());
                                if (parts.length >= 3) {
                                    addStationRow(parts[0], parts[1], parts[2]);
                                }
                            });
                        }

                        // Populate paths table
                        if (scen.data.paths && typeof addPathRow === 'function') {
                            const pathLines = scen.data.paths.split('\n').filter(l => l.trim());
                            pathLines.forEach(line => {
                                const parts = line.split(',').map(p => p.trim());
                                if (parts.length >= 3) {
                                    addPathRow(parts[0], parts[1], parts[2], parts[3] || '#e74c3c');
                                }
                            });
                        }
                    }, 100);
                }
            }
            updateVisual();
        }


        function updateVisual() {
            // Gather data
            const tool = toolDB[currentToolId];
            const data = {};
            tool.inputs.forEach(f => {
                if (f.type === 'table' && typeof window['getTableData_' + f.id] === 'function') {
                    // Get table data as array of objects
                    const tableData = window['getTableData_' + f.id]();
                    // Convert to pipe-separated format for backward compatibility
                    data[f.id] = tableData.map(row => {
                        return f.columns.map(col => row[col.key] || '').join(' | ');
                    }).join('\n');
                    // Also store as array for direct access
                    data[f.id + '_array'] = tableData;
                } else {
                    const el = document.getElementById('input-' + f.id);
                    data[f.id] = el ? el.value : "";
                }
            });

            // Render
            const html = tool.render(data);
            document.getElementById('visualCanvas').innerHTML = html;
        }

        function downloadPNG() {
            const el = document.getElementById('visualCanvas');
            const originalBg = el.style.background;
            el.style.background = '#ffffff'; // Ensure white bg

            html2canvas(el, { scale: 2, backgroundColor: '#ffffff', useCORS: true }).then(canvas => {
                const link = document.createElement('a');
                link.download = `${currentToolId}_visual_export.png`;
                link.href = canvas.toDataURL('image/png');
                link.click();
                el.style.background = originalBg;
            }).catch(err => {
                console.error("Export Failed", err);
                alert("Export failed. See console.");
                el.style.background = originalBg;
            });
        }

        // AI Mock
        // --- HELP MODAL LOGIC ---
        function showHelpModal() {
            let modal = document.getElementById('helpModal');
            if (!modal) {
                modal = document.createElement('div');
                modal.id = 'helpModal';
                modal.style.cssText = "position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); z-index:9999; display:flex; align-items:center; justify-content:center; backdrop-filter:blur(5px);";
                modal.innerHTML = `
                    <div style="background:var(--surface-1); padding:30px; border-radius:12px; max-width:500px; color:white; border:1px solid var(--accent); box-shadow:0 10px 30px rgba(0,0,0,0.5);">
                        <h2 style="margin-top:0; color:var(--accent);">??? Tool Help & Guide</h2>
                        <p><strong>1. Select Scenario:</strong> Choose a pre-filled example (Healthcare, Manufacturing) to understand how the tool works.</p>
                        <p><strong>2. Input Data:</strong> Enter your specific project data into the fields. Use the "AI Auto-Fill" button to generate realistic content automatically!</p>
                        <p><strong>3. Analyze:</strong> The "Interpretation" card provides tips on what to look for in your results.</p>
                        <button class="btn btn-primary" onclick="document.getElementById('helpModal').style.display='none'" style="width:100%; margin-top:20px;">Got it!</button>
                    </div>
                `;
                document.body.appendChild(modal);
            }
            modal.style.display = 'flex';
        }

        // --- AI AUTO-FILL LOGIC ---
        async function askAIData() {
            let apiKey = localStorage.getItem('gemini_api_key');

            // Check if key is stored, if not ask user
            if (!apiKey) {
                const inputKey = prompt("? To use AI Auto-Fill, please enter your Google Gemini API Key:\n\n(This will be saved locally in your browser for future use.)");
                if (inputKey && inputKey.trim().length > 0) {
                    apiKey = inputKey.trim();
                    localStorage.setItem('gemini_api_key', apiKey);
                } else {
                    alert("?? API Key is required to use AI features.");
                    return;
                }
            }

            const tool = toolDB[currentToolId];
            const btn = document.querySelector('.btn-ghost[onclick="askAIData()"]');
            const originalText = btn.innerText;
            btn.innerText = "? Generating...";
            btn.style.opacity = "0.7";
            btn.disabled = true;

            // Construct Prompt
            const fieldsDef = tool.inputs.map(f => `- ${f.id}: ${f.label} (${f.type})`).join('\n');
            const prompt = `
                You are a Lean Six Sigma Master Black Belt. 
                Task: Generate realistic, professional scenario data for the "${tool.title}" tool.
                Context: The user is working on a generic process improvement project (or specifically Healthcare if appropriate).
                
                REQUIREMENTS:
                1. Provide valid JSON strictly.
                2. keys MUST match: [${tool.inputs.map(i => i.id).join(', ')}]
                3. Content should be detailed and educational.
                
                Field Definitions:
                ${fieldsDef}
                
                Response format: JSON object only. No markdown.
            `;

            try {
                // Call Gemini API
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${apiKey}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: prompt }] }]
                    })
                });

                if (!response.ok) {
                    const err = await response.json();
                    throw new Error(err.error?.message || response.statusText);
                }

                const result = await response.json();
                let text = result.candidates?.[0]?.content?.parts?.[0]?.text;

                if (!text) throw new Error("No content returned from AI.");

                // Clean Markdown code blocks if present
                text = text.replace(/```json/g, '').replace(/```/g, '').trim();

                const json = JSON.parse(text);

                // Populate Inputs
                for (const [key, val] of Object.entries(json)) {
                    const el = document.getElementById(key);
                    if (el) el.value = typeof val === 'object' ? JSON.stringify(val) : val;
                }

                // Refresh Visuals
                updateVisual();
                alert("? AI Data Generated Successfully!");

            } catch (error) {
                console.error("AI Error:", error);
                alert("? AI Generation Failed:\n" + error.message + "\n\n(If 'API Key' invalid, clear browser cache or use a new key.)");
                if (error.message.includes('API key') || error.message.includes('403') || error.message.includes('400')) {
                    if (confirm("Your API Key seems invalid. Would you like to reset it?")) {
                        localStorage.removeItem('gemini_api_key');
                    }
                }
            } finally {
                btn.innerText = originalText;
                btn.style.opacity = "1";
                btn.disabled = false;
            }
        }

        // Initialize
        // Initialize with URL param support
        window.onload = () => {
            const urlParams = new URLSearchParams(window.location.search);
            const toolParam = urlParams.get('tool');
            // Check if tool exists in toolDB, otherwise default to sipoc
            const initialTool = (toolParam && toolDB[toolParam]) ? toolParam : 'sipoc';
            renderTool(initialTool);
        };

    </script>
