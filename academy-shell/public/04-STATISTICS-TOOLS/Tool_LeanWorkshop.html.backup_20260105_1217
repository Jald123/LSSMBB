                why: "To identify non-value-added time (waste) and opportunities for improvement.",
                when: "Start of projects to see 'current state' and design 'future state'.",
                standard: "Symbols: Process Box, Databox, Inventory Triangle, Timeline.",
                interp: "Key Metric: Process Cycle Efficiency = Value Added Time / Total Lead Time.",
                ref: "Tip: Walk the process (Gemba) to collect real time data.",
                steps: [
                    { title: "1. Define Steps", desc: "List process steps in sequence." },
                    { title: "2. Add Data", desc: "Input Cycle Time (C/T), Changeover (C/O), and Uptime." },
