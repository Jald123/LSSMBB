                            </tr>
                        </thead>
                        <tbody>
                            ${scoredInputs.map((inp, i) => `
                                <tr style="background:${i < 3 ? '#fff9c4' : 'white'}; border-bottom:1px solid #ecf0f1;">
                                    <td style="padding:12px; font-weight:bold; color:#2c3e50;">${inp.name}</td>
                                    ${outputs.map((_, j) => {
                        const c = inp.corrs[j] || 0;
                        let bg = 'transparent';
                        let color = '#bdc3c7';
                        if (c === 9) { bg = '#e74c3c'; color = 'white'; }
                        else if (c === 3) { bg = '#f39c12'; color = 'white'; }
                        else if (c === 1) { bg = '#2ecc71'; color = 'white'; }
                        return `<td style="text-align:center; padding:8px;">
                                            <span style="display:inline-block; width:24px; height:24px; line-height:24px; border-radius:50%; background:${bg}; color:${color}; font-weight:bold; font-size:11px;">${c}</span>
