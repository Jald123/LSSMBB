    <script>
        let recPath = 'dmaic';

        // --- BELT FILTERING LOGIC ---
        function filterBelt() {
            const belt = document.getElementById('beltFilter').value;
            const rows = document.querySelectorAll('.tool-row');

            rows.forEach(row => {
                const rowBelt = row.getAttribute('data-belt'); // y, g, b
                if (!rowBelt) return; // Skip if no belt data

                let show = false;
                if (belt === 'all') {
                    show = true;
                } else if (belt === 'yellow') {
                    if (rowBelt === 'y') show = true;
                } else if (belt === 'green') {
                    if (rowBelt === 'y' || rowBelt === 'g') show = true;
                } else if (belt === 'black') {
                    // Black includes everything
                    show = true;
                }

                row.style.display = show ? 'grid' : 'none';
            });
        }

        // TRIAGE
        function nextTriage(q, val) {
            document.querySelectorAll('.triage-step').forEach(el => el.classList.remove('active'));
            document.getElementById('q' + q).classList.add('active');
        }
        function endTriage(path) {
            recPath = path;
            document.querySelectorAll('.triage-step').forEach(el => el.classList.remove('active'));
            document.getElementById('triageResult').classList.add('active');
            const titles = { 'dmaic': 'Recommended: DMAIC', 'dmadv': 'Recommended: DMADV', 'kaizen': 'Recommended: Kaizen Event' };
            document.getElementById('recTitle').innerText = titles[path];
        }
        function resetTriage() {
            document.querySelectorAll('.triage-step').forEach(el => el.classList.remove('active'));
            document.getElementById('q1').classList.add('active');
        }
        function skipTriage() { window.scrollTo({ top: 400, behavior: 'smooth' }); }

        // TABS
        function activatePath(path) {
            document.querySelectorAll('.path-tab').forEach(t => t.classList.remove('active'));
            document.querySelector('.tab-' + path).classList.add('active');
            document.querySelectorAll('.workflow-path').forEach(p => p.classList.remove('active'));
            document.getElementById('path-' + path).classList.add('active');
            window.scrollTo({ top: 400, behavior: 'smooth' });
            updateProgress(path);
        }

        function toggleStage(header) {
            header.nextElementSibling.classList.toggle('open');
        }

        function togglePhaseAll(btn, contentId) {
            const container = document.getElementById(contentId);
            // Only toggle visible items based on filter!
            const belt = document.getElementById('beltFilter').value;
            const checkboxes = Array.from(container.querySelectorAll('.tool-row')).filter(r => r.style.display !== 'none').map(r => r.querySelector('.tool-check'));

            let allChecked = true;
            checkboxes.forEach(c => { if (!c.checked) allChecked = false; });

            const newState = !allChecked;
            checkboxes.forEach(c => c.checked = newState);

            btn.innerText = newState ? "Deselect All" : "Select All";
            updateProgress('dmaic');
        }

        // PROGRESS
        function updateProgress(boxType) {
            const container = document.getElementById('path-' + boxType);
            if (!container) return;

            const allChecks = container.querySelectorAll('.tool-check');
            let checkedCount = 0;
            allChecks.forEach(c => {
                if (c.checked) {
                    checkedCount++;
                    c.closest('.tool-row').classList.add('completed');
                } else {
                    c.closest('.tool-row').classList.remove('completed');
                }
            });
            const pct = allChecks.length > 0 ? Math.round((checkedCount / allChecks.length) * 100) : 0;
            document.getElementById('sidebar-percent').innerText = pct + '%';

            function updateStageStatus(stageClass, statusId, contentId) {
                const stage = container.querySelector('.' + stageClass);
                if (!stage) return;

                const mandatories = stage.querySelectorAll('.tool-row[data-type="mandatory"] input.tool-check');
                let allMandatoryDone = true;
                if (mandatories.length === 0) allMandatoryDone = true;
                mandatories.forEach(m => { if (!m.checked) allMandatoryDone = false; });

                const statusEl = document.getElementById(statusId);
                if (statusEl) {
                    statusEl.innerText = allMandatoryDone ? "✓ Complete" : "In Progress";
                    statusEl.style.color = allMandatoryDone ? "var(--success)" : "inherit";
                }
            }

            if (boxType === 'dmaic') {
                updateStageStatus('dmaic-1', 'dmaic-status-1', 'dmaic-content-1');
                updateStageStatus('dmaic-2', 'dmaic-status-2', 'dmaic-content-2');
                updateStageStatus('dmaic-3', 'dmaic-status-3', 'dmaic-content-3');
                updateStageStatus('dmaic-4', 'dmaic-status-4', 'dmaic-content-4');
                updateStageStatus('dmaic-5', 'dmaic-status-5', 'dmaic-content-5');
            }
            saveState();
        }

        function saveState() {
            const state = [];
            document.querySelectorAll('.tool-check').forEach(c => state.push(c.checked));
            localStorage.setItem('workflow_hub_state_v7', JSON.stringify(state));
        }

        function loadState() {
            const state = JSON.parse(localStorage.getItem('workflow_hub_state_v7'));
