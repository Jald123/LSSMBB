<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Workflow Hub | Black Belt Studio</title>
    <link rel="stylesheet" href="twilight_theme.css">
    <script src="config.js"></script>
    <style>
        :root {
            --dmaic-color: #3498db;
            --dmadv-color: #1abc9c;
            --kaizen-color: #2ecc71;

            --define: #3498db;
            --measure: #2ecc71;
            --analyze: #f39c12;
            --improve: #f1c40f;
            --control: #e74c3c;

            --design: #9b59b6;
            --verify: #8e44ad;
        }

        .hub-container {
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 25px;
            max-width: 1600px;
            margin: 0 auto;
        }

        @media (max-width: 1024px) {
            .hub-container {
                grid-template-columns: 1fr;
            }
        }

        /* NAVIGATION BAR */
        .app-nav-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: linear-gradient(90deg, #111, #1a1a1a);
            padding: 10px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .nav-left {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-logo {
            font-weight: bold;
            font-size: 18px;
            color: var(--accent);
            text-decoration: none;
        }

        .nav-link {
            color: #ccc;
            text-decoration: none;
            font-size: 14px;
            padding: 5px 10px;
            border-radius: 4px;
            transition: 0.2s;
        }

        .nav-link:hover {
            background: rgba(255, 255, 255, 0.1);
            color: white;
        }

        .nav-btn-back {
            background: var(--surface-2);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 12px;
            cursor: pointer;
            text-decoration: none;
        }

        .nav-btn-back:hover {
            background: var(--surface-1);
        }

        /* TRIAGE SECTION */
        .triage-card {
            background: linear-gradient(145deg, rgba(52, 152, 219, 0.1), rgba(0, 0, 0, 0.3));
            border: 1px solid var(--accent);
            padding: 30px;
            border-radius: 12px;
            margin-bottom: 30px;
            position: relative;
            overflow: hidden;
            border-left: 5px solid var(--accent);
            margin-top: 20px;
        }

        .triage-step {
            display: none;
            animation: fadeIn 0.4s ease;
        }

        .triage-step.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* TABS */
        .path-tabs {
            display: flex;
            gap: 5px;
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .path-tab {
            padding: 12px 25px;
            background: var(--surface-2);
            border-radius: 8px 8px 0 0;
            cursor: pointer;
            font-weight: bold;
            color: var(--text-secondary);
            border: 1px solid transparent;
            border-bottom: none;
            opacity: 0.7;
            transition: 0.2s;
        }

        .path-tab:hover {
            opacity: 1;
            background: var(--surface-1);
        }

        .path-tab.active {
            opacity: 1;
            color: white;
            background: var(--bg-dark);
            border-top: 3px solid var(--accent);
        }

        .tab-dmaic.active {
            border-top-color: var(--dmaic-color);
        }

        .tab-dmadv.active {
            border-top-color: var(--dmadv-color);
        }

        .tab-kaizen.active {
            border-top-color: var(--kaizen-color);
        }

        /* PATH CONTAINERS */
        .workflow-path {
            display: none;
        }

        .workflow-path.active {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        /* STAGE CARDS */
        .stage-card {
            background: var(--surface-1);
            border-radius: 8px;
            margin-bottom: 20px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: 0.3s;
            position: relative;
        }

        .stage-header {
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            border-left: 5px solid transparent;
            background: var(--surface-2);
        }

        /* DMAIC COLORS */
        .dmaic-1 .stage-header {
            border-left-color: var(--define);
        }

        .dmaic-2 .stage-header {
            border-left-color: var(--measure);
        }

        .dmaic-3 .stage-header {
            border-left-color: var(--analyze);
        }

        .dmaic-4 .stage-header {
            border-left-color: var(--improve);
        }

        .dmaic-5 .stage-header {
            border-left-color: var(--control);
        }

        /* DMADV COLORS */
        .dmadv-1 .stage-header {
            border-left-color: var(--define);
        }

        .dmadv-2 .stage-header {
            border-left-color: var(--measure);
        }

        .dmadv-3 .stage-header {
            border-left-color: var(--analyze);
        }

        .dmadv-4 .stage-header {
            border-left-color: var(--design);
        }

        .dmadv-5 .stage-header {
            border-left-color: var(--verify);
        }

        .stage-content {
            padding: 0;
            display: none;
        }

        .stage-content.open {
            display: block;
        }

        /* Fix Modal Overlay */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 2000;
            backdrop-filter: blur(8px);
        }

        .fancy-modal {
            width: 90%;
            max-width: 600px;
            padding: 40px;
            border-radius: 16px;
            position: relative;
        }

        .close-btn {
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 30px;
            cursor: pointer;
            color: #fff;
            opacity: 0.7;
        }

        .close-btn:hover {
            opacity: 1;
        }

        /* TOOLS ROWS - MODERNIZED */
        .tool-row {
            display: grid;
            grid-template-columns: 50px 1fr 100px 100px 60px 100px;
            align-items: center;
            padding: 16px 24px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.2s ease;
            background: rgba(255, 255, 255, 0.01);
            position: relative;
        }

        .tool-row:hover {
            background: rgba(255, 255, 255, 0.04);
            transform: translateX(4px);
            border-left: 2px solid var(--accent);
        }

        .tool-row.completed {
            background: rgba(46, 204, 113, 0.05);
            border-left: 2px solid var(--success);
        }

        /* Text Column (Name & Why) - Target 2nd child div */
        .tool-row>div:nth-child(2) {
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 4px;
        }

        .tool-check {
            width: 20px;
            height: 20px;
            accent-color: var(--success);
            cursor: pointer;
            opacity: 0.6;
        }

        .tool-check:checked {
            opacity: 1;
        }

        .tool-name {
            font-weight: 600;
            color: #fff;
            font-size: 15px;
            text-decoration: none;
            display: block;
            letter-spacing: 0.3px;
        }

        .tool-name:hover {
            color: var(--accent);
        }

        .tool-why {
            font-size: 12px;
            color: #94A3B8;
            display: block;
            font-weight: 400;
        }

        /* Action Buttons */
        .tool-row .btn-sm {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--accent);
            padding: 8px 0;
            font-size: 10px;
            border-radius: 4px;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-align: center;
            display: block;
            width: 100%;
            transition: all 0.2s;
        }

        .tool-row .btn-sm:hover {
            background: var(--accent);
            color: white;
            border-color: var(--accent);
            box-shadow: 0 0 10px rgba(255, 107, 53, 0.3);
            text-decoration: none;
        }

        /* Modernized Badges */
        .method-badge {
            font-size: 9px;
            padding: 4px 0;
            width: 85px;
            border-radius: 4px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: inline-block;
            text-align: center;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #777;
        }

        .method-lean {
            color: #2ecc71;
            border-color: rgba(46, 204, 113, 0.3);
            background: rgba(46, 204, 113, 0.05);
        }

        .method-ss {
            color: #9b59b6;
            border-color: rgba(142, 68, 173, 0.3);
            background: rgba(142, 68, 173, 0.05);
        }

        .method-gen {
            color: #95a5a6;
        }

        /* BADGES */
        .prio-badge {
            font-size: 9px;
            padding: 4px 6px;
            border-radius: 4px;
            font-weight: bold;
            text-transform: uppercase;
            border: 1px solid;
            display: inline-block;
            text-align: center;
            min-width: 75px;
        }

        .prio-crit {
            color: #e74c3c;
            border-color: #e74c3c;
            background: rgba(231, 76, 60, 0.1);
        }

        .prio-rec {
            color: #f1c40f;
            border-color: #f1c40f;
            background: rgba(241, 196, 15, 0.1);
        }

        .prio-opt {
            color: #95a5a6;
            border-color: #95a5a6;
            background: rgba(149, 165, 166, 0.1);
        }

        .belt-badge {
            font-size: 9px;
            padding: 2px 5px;
            border-radius: 3px;
            font-weight: bold;
            text-transform: uppercase;
            border: 1px solid transparent;
        }

        .belt-y {
            background: #f1c40f;
            color: #000;
        }

        .belt-g {
            background: #2ecc71;
            color: #000;
        }

        .belt-b {
            background: #000;
            color: white;
            border-color: #555;
        }

        .section-separator {
            padding: 8px 20px;
            background: rgba(255, 255, 255, 0.02);
            font-size: 11px;
            font-weight: bold;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .phase-select-all {
            font-size: 11px;
            color: var(--accent);
            cursor: pointer;
            opacity: 0.8;
            margin-right: 15px;
        }

        .phase-select-all:hover {
            opacity: 1;
            text-decoration: underline;
        }

        /* NEW INFOGRAPHIC STYLES */
        .skills-banner {
            background: linear-gradient(90deg, rgba(255, 107, 53, 0.1) 0%, rgba(46, 204, 113, 0.05) 100%);
            padding: 15px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .skills-title {
            color: var(--accent);
            font-weight: 800;
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .skills-list {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            font-size: 11px;
            color: #aaa;
        }

        .skills-list span:nth-child(even) {
            color: #444;
        }

        /* separators */

        /* Updated Tool Row Layout for Icon */
        .tool-row {
            grid-template-columns: 50px 1fr 90px 80px 40px 110px;
            /* Adjusted columns */
        }

        .tool-icon-box {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.05);
            display: grid;
            place-items: center;
            font-size: 16px;
        }

        .tool-action {
            display: flex;
            gap: 10px;
            align-items: center;
        }
    </style>
</head>

<body>
    <!-- ADVANCED NAV BAR (Global Component) -->
    <nav class="app-nav-bar">
        <div class="nav-left">
            <a href="Stats_Calculator_Main.html" class="nav-logo">⚡ Lean Studio</a>
            <a href="Tool_WorkflowHub.html" class="nav-link">Workflow Guide</a>
            <a href="Stats_Calculator_Main.html" class="nav-link">Stats Engine</a>
        </div>
        <div class="nav-right">
            <div style="display:flex; align-items:center; gap:10px; margin-right:20px;">
                <label style="font-size:12px; color:#aaa;">Filter Belt:</label>
                <select id="beltFilter" onchange="filterBelt()"
                    style="background:#222; border:1px solid #444; color:white; padding:4px; border-radius:4px; font-size:12px;">
                    <option value="all">Select All (Full Suite)</option>
                    <option value="yellow">Yellow Belt Only</option>
                    <option value="green">Green Belt (+ Yellow)</option>
                    <option value="black">Black Belt (All)</option>
                </select>
            </div>
            <a href="Stats_Calculator_Main.html" class="nav-btn-back">← Dashboard</a>
        </div>
    </nav>

    <div class="container">
        <!-- HEADER CONTENT -->
        <div class="flex-between" style="margin-bottom: 20px; margin-top:20px;">
            <div>
                <span class="phase-glow">LEARNING HUB</span>
                <h1>Project Workflow Guide <span class="ai-badge">SMART</span></h1>
                <p style="color:var(--text-secondary);">Comprehensive workflow logic with Belt Level filtering.</p>
            </div>
        </div>

        <!-- PHASE 0: FOUNDATION & STRATEGY -->
        <div class="card"
            style="border-left: 4px solid var(--accent); background: linear-gradient(135deg, rgba(255, 107, 53, 0.1), rgba(0,0,0,0)); margin-bottom:20px;">
            <div class="flex-between">
                <div>
                    <h2 style="margin:0; font-size:20px; color:var(--text-primary);">Phase 0: Foundation & Strategy</h2>
                    <p style="margin:5px 0 0 0; color:var(--text-secondary); font-size:13px;">Master the basics before
                        you begin.</p>
                </div>
                <span class="belt-badge belt-y">Required</span>
            </div>
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:15px; margin-top:15px;">
                <div
                    style="background:var(--surface-2); padding:15px; border-radius:8px; border:1px solid rgba(255,255,255,0.05); display:flex; align-items:center; gap:15px;">
                    <div style="font-size:24px;">📘</div>
                    <div>
                        <div style="font-weight:bold; color:var(--accent);">LSS Fundamentals</div>
                        <div style="font-size:11px; color:#aaa;">History, Belts, Principles.</div>
                        <a href="Tool_LSS_Fundamentals.html" class="btn btn-sm btn-ghost" style="margin-top:5px;">Open
                            Guide</a>
                    </div>
                </div>
                <div
                    style="background:var(--surface-2); padding:15px; border-radius:8px; border:1px solid rgba(255,255,255,0.05); display:flex; align-items:center; gap:15px;">
                    <div style="font-size:24px;">🔭</div>
                    <div>
                        <div style="font-weight:bold; color:var(--accent);">Project Scoping</div>
                        <div style="font-size:11px; color:#aaa;">Select the right project.</div>
                        <a href="Tool_ProjectTriage.html" class="btn btn-sm btn-ghost" style="margin-top:5px;">Launch
                            Tool</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- TRIAGE SECTION -->
        <div id="triageSection" class="triage-card">
            <h2 style="margin-top:0; display:flex; gap:10px; align-items:center;">
                <span style="font-size:24px;">⚖️</span>
                Methodology Triage
                <button class="btn btn-sm btn-ghost" onclick="skipTriage()"
                    style="margin-left:auto; font-size:12px; font-weight:normal; border:1px solid #555;">Skip Triage
                    →</button>
            </h2>
            <div id="q1" class="triage-step active">
                <p style="font-size:16px; margin-bottom:20px;">1. Are you working on an <strong>Existing
                        Process</strong> or a <strong>New Design</strong>?</p>
                <div style="display:flex; gap:15px;">
                    <button class="btn btn-primary" onclick="nextTriage(2, 'existing')">Existing Process</button>
                    <button class="btn btn-primary"
                        style="background:var(--dmadv-color); border-color:var(--dmadv-color);"
                        onclick="endTriage('dmadv')">New / Redesign</button>
                </div>
            </div>
            <div id="q2" class="triage-step">
                <p style="font-size:16px; margin-bottom:20px;">2. Is the root cause <strong>Unknown & Complex</strong>,
                    or <strong>Obvious</strong>?</p>
                <div style="display:flex; gap:15px;">
                    <button class="btn btn-primary" onclick="endTriage('dmaic')">Unknown / Complex</button>
                    <button class="btn btn-primary"
                        style="background:var(--kaizen-color); border-color:var(--kaizen-color);"
                        onclick="endTriage('kaizen')">Obvious / Quick Win</button>
                </div>
            </div>
            <div id="triageResult" class="triage-step" style="text-align:center;">
                <h3 id="recTitle" style="color:var(--success); font-size:22px;">Recommended: DMAIC</h3>
                <p id="recText" style="color:#ccc; margin-bottom:20px;">Standard rigorous problem solving.</p>
                <button class="btn btn-primary" onclick="activatePath(recPath)">Start Workflow</button>
                <button class="btn btn-ghost" onclick="resetTriage()">Restart</button>
            </div>
        </div>

        <div class="hub-container">
            <!-- WORKFLOW CONTENT -->
            <div class="workflow-content">

                <!-- TABS -->
                <div class="path-tabs">
                    <div class="path-tab tab-dmaic active" onclick="activatePath('dmaic')">DMAIC (Improve)</div>
                    <div class="path-tab tab-dmadv" onclick="activatePath('dmadv')">DMADV (Design)</div>
                    <div class="path-tab tab-kaizen" onclick="activatePath('kaizen')">Kaizen (Event)</div>
                </div>

                <!-- DMAIC PATH -->
                <div id="path-dmaic" class="workflow-path active">
                    <!-- 1. DEFINE -->
                    <div class="stage-card dmaic-1">
                        <div class="stage-header" onclick="toggleStage(this)">
                            <div>
                                <h3 style="display:flex; align-items:center; gap:10px;">1. DEFINE <span
                                        style="font-size:16px; cursor:pointer; opacity:0.8;"
                                        onclick="showWisdom('define'); event.stopPropagation();"
                                        title="Phase Wisdom">💡</span></h3>
                                <div style="font-size:12px;opacity:0.7;">Charter, Scope, VOC, Teams</div>
                            </div>
                            <div style="display:flex; align-items:center;">
                                <span class="phase-select-all"
                                    onclick="togglePhaseAll(this, 'dmaic-content-1'); event.stopPropagation();">Select
                                    All</span>
                                <div style="font-size:10px;" id="dmaic-status-1">Open</div>
                            </div>
                        </div>
                        <div id="dmaic-content-1" class="stage-content open">
                            <!-- Premium Tools -->
                            <!-- SKILLS GAINED -->
                            <div class="skills-banner">
                                <div class="skills-title">🚀 SKILLS UNLOCKED:</div>
                                <div class="skills-list">
                                    <span>Problem Scoping</span> <span>•</span> <span>Stakeholder Management</span>
                                    <span>•</span> <span>Process Mapping</span> <span>•</span> <span>Voice of Customer
                                        (VOC)</span>
                                </div>
                            </div>

                            <!-- Premium Tools -->
                            <div class="section-separator">Project Management</div>
                            <div class="tool-row" data-type="mandatory" data-belt="y">
                                <div class="tool-icon-box"
                                    style="background:rgba(255, 107, 53, 0.2); color:var(--accent);">👑</div>
                                <div style="flex-grow:1;">
                                    <a href="Tool_ProjectCharter_Premium.html" class="tool-name">Project Charter
                                        (Premium)</a>
                                    <span class="tool-why">Define scope/team. The project contract.</span>
                                </div>
                                <span class="method-badge method-gen">PROJ. MGMT</span>
                                <span class="prio-badge prio-crit">Priority 1</span>
                                <span class="belt-badge belt-y">YB</span>
                                <div class="tool-action">
                                    <input type="checkbox" class="tool-check" onchange="updateProgress('dmaic')">
                                    <a href="Tool_ProjectCharter_Premium.html" class="btn btn-sm">Launch</a>
                                </div>
                            </div>
                            <div class="tool-row" data-type="mandatory" data-belt="g">
                                <div class="tool-icon-box"
                                    style="background:rgba(255, 107, 53, 0.2); color:var(--accent);">🤝</div>
                                <div style="flex-grow:1;">
                                    <a href="Tool_StakeholderAnalysis.html" class="tool-name">Stakeholder Matrix</a>
                                    <span class="tool-why">Who cares? Manage influence & interest.</span>
                                </div>
                                <span class="method-badge method-gen">PROJ. MGMT</span>
                                <span class="prio-badge prio-crit">Priority 2</span>
                                <span class="belt-badge belt-g">GB</span>
                                <div class="tool-action">
                                    <input type="checkbox" class="tool-check" onchange="updateProgress('dmaic')">
                                    <a href="Tool_StakeholderAnalysis.html" class="btn btn-sm">Launch</a>
                                </div>
                            </div>
                            <div class="tool-row" data-type="mandatory" data-belt="b">
                                <div class="tool-icon-box" style="background:rgba(231, 76, 60, 0.2); color:#e74c3c;">🩺
                                </div>
                                <div style="flex-grow:1;">
                                    <a href="Tool_ProjectTriage.html" class="tool-name">Project Triage & Scoping</a>
                                    <span class="tool-why">Is this project viable? Validate problem statement.</span>
                                </div>
                                <span class="method-badge method-gen">PROJ. MGMT</span>
                                <span class="prio-badge prio-crit">Priority 3</span>
                                <span class="belt-badge belt-b">BB</span>
                                <div class="tool-action">
                                    <input type="checkbox" class="tool-check" onchange="updateProgress('dmaic')">
                                    <a href="Tool_ProjectTriage.html" class="btn btn-sm">Launch</a>
                                </div>
                            </div>

                            <!-- Design / Visual Tools -->
                            <div class="section-separator">Visual & Workshop</div>
                            <div class="tool-row" data-type="mandatory" data-belt="y">
                                <div class="tool-icon-box" style="background:rgba(46, 204, 113, 0.2); color:#2ecc71;">
                                    🗺️</div>
                                <div style="flex-grow:1;">
                                    <a href="Tool_LeanWorkshop.html?tool=sipoc" class="tool-name">SIPOC Diagram</a>
                                    <span class="tool-why">High-level map (Supplier->Customer).</span>
