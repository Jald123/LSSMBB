generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          String    @default("STUDENT") // ADMIN, STUDENT, TRIAL
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects      Project[]
  doProjects    DoProject[]
  badgeAwards   BadgeAward[]
  certAwards    CertificateAward[]
}

model Framework {
  id          String   @id @default(cuid())
  name        String   @unique // DMAIC, DMADV, KAIZEN, PDCA, FOCUS-PDCA
  description String?
  steps       Phase[]
  projects    Project[]
}

model Phase {
  id          String   @id @default(cuid())
  name        String
  order       Int
  frameworkId String
  framework   Framework @relation(fields: [frameworkId], references: [id])
  mappings    ToolStepMapping[]
}

model Tool {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String? // Define, Measure, etc.
  mappings    ToolStepMapping[]
}

model ToolStepMapping {
  id      String @id @default(cuid())
  toolId  String
  phaseId String
  tool    Tool   @relation(fields: [toolId], references: [id])
  phase   Phase  @relation(fields: [phaseId], references: [id])

  @@unique([toolId, phaseId])
}

model CaseStudy {
  id            String   @id @default(cuid())
  title         String
  category      String   // MEDICAL, DAILY_LIFE, INVESTMENT
  difficulty    Int      // 1-5
  estimatedTime String?
  story         String?
  objectives    String?  // JSON stringified array
  datasets      String?  // References to pack components
  projects      Project[]
}

model Project {
  id            String   @id @default(cuid())
  userId        String
  frameworkId   String
  caseStudyId   String?  // Null if custom
  title         String
  status        String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User       @relation(fields: [userId], references: [id])
  framework     Framework  @relation(fields: [frameworkId], references: [id])
  caseStudy     CaseStudy? @relation(fields: [caseStudyId], references: [id])
  deliverables  Deliverable[]
  progress      Progress?
  intake        ProjectIntake?
}

model ProjectIntake {
  id               String  @id @default(cuid())
  projectId        String  @unique
  problemStatement String?
  businessCase     String?
  goal             String?
  scopeIn          String?
  scopeOut         String?
  stakeholders     String?
  baselineMetric   String?
  constraints      String?
  timeline         String?
  project          Project @relation(fields: [projectId], references: [id])
}

model Deliverable {
  id          String   @id @default(cuid())
  projectId   String
  toolId      String
  status      String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETE
  content     String?  // JSON storage for tool data
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
  
  project     Project  @relation(fields: [projectId], references: [id])
}

model Progress {
  id              String  @id @default(cuid())
  projectId       String  @unique
  completedSteps  Int     @default(0)
  totalSteps      Int
  project         Project @relation(fields: [projectId], references: [id])
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  icon        String?
  type        String   // TOOL, PHASE, FRAMEWORK
  awards      BadgeAward[]
}

model BadgeAward {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])
}

model CertificateAward {
  id             String   @id @default(cuid())
  userId         String
  projectId      String
  verificationId String   @unique
  issuedAt       DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}

// --- NEW DO MODE MODELS ---

model DoProject {
  id                 String    @id @default(uuid())
  studentId          String    @map("student_id")
  caseId             String    @map("case_id")
  framework          String    // DMAIC, DMADV
  title              String
  status             String    @default("active") // active, completed, archived
  currentPhase       String    @map("current_phase")
  progressPercentage Int       @default(0) @map("progress_percentage")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user               User      @relation(fields: [studentId], references: [id])
  deliverables       DoDeliverable[]
  phaseGates         ProjectPhaseGate[]

  @@map("projects")
}

model DoDeliverable {
  id           String    @id @default(uuid())
  projectId    String    @map("project_id")
  toolId       String    @map("tool_id")
  phase        String
  status       String    @default("not-started") // not-started, in-progress, complete
  priority     String    // essential, recommended, optional
  formData     Json?     @map("form_data")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Retry System Fields
  attempts     Int       @default(0)
  maxAttempts  Int       @default(4)
  score        Float?
  feedback     String?
  retryHistory Json?     @map("retry_history") // Array of previous attempts

  project      DoProject @relation(fields: [projectId], references: [id])

  @@map("deliverables")
}

model ProjectPhaseGate {
  id           String    @id @default(uuid())
  projectId    String    @map("project_id")
  phase        String
  status       String    @default("locked") // locked, unlocked, completed
  unlockedAt   DateTime? @map("unlocked_at")
  completedAt  DateTime? @map("completed_at")

  project      DoProject @relation(fields: [projectId], references: [id])

  @@map("project_phase_gates")
}
