{
    "version": 2,
    "buildCommand": "cd nexus-shell && npm install && npm run build",
    "outputDirectory": "nexus-shell/dist",
    "rewrites": [
        {
            "source": "/(04-STATISTICS-TOOLS|02-TEMPLATES)/(.*)",
            "destination": "/$1/$2"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}